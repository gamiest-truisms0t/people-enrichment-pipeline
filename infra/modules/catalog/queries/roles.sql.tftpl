-- 3. What roles have they held?
SELECT p.batch_date,
       p.full_name,
       e.title_name,
       e.title_role,
       e.title_levels,
       e.company_name,
       e.start_date,
       e.end_date
FROM ${database}.fact_employment e
JOIN ${database}.dim_person p
  ON p.person_id = e.person_id
 AND p.batch_id = e.batch_id
 AND p.batch_date = e.batch_date
ORDER BY p.batch_date DESC, p.full_name, e.sequence_no;
