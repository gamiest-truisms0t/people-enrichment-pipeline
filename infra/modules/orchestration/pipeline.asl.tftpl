{
  "Comment": "People-enrichment pipeline: validate the uploaded CSV, enrich each row, build the curated tables. Input: {\"bucket\": \"<landing bucket>\", \"key\": \"incoming/<folder>/<file>.csv\"}",
  "StartAt": "ValidateInput",
  "TimeoutSeconds": 3600,
  "States": {
    "ValidateInput": {
      "Type": "Task",
      "Comment": "Parse and validate the CSV; rows travel inline for the Map, the full parsed input is written to the data bucket.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${validate_input_arn}",
        "Payload": {
          "bucket.$": "$.bucket",
          "key.$": "$.key",
          "execution_id.$": "$$.Execution.Id",
          "trigger.$": "$"
        }
      },
      "ResultSelector": {
        "batch_id.$": "$.Payload.batch_id",
        "batch_date.$": "$.Payload.batch_date",
        "row_count.$": "$.Payload.row_count",
        "invalid_count.$": "$.Payload.invalid_count",
        "input_ref.$": "$.Payload.input_ref",
        "rejected_rows_ref.$": "$.Payload.rejected_rows_ref",
        "duplicate.$": "$.Payload.duplicate",
        "owner_execution.$": "$.Payload.owner_execution",
        "rows.$": "$.Payload.rows"
      },
      "ResultPath": "$.batch",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "IsDuplicateTrigger"
    },
    "IsDuplicateTrigger": {
      "Type": "Choice",
      "Comment": "S3 and EventBridge deliver at least once; the first execution to claim the object version owns the batch.",
      "Choices": [
        {
          "Variable": "$.batch.duplicate",
          "BooleanEquals": true,
          "Next": "DuplicateIgnored"
        }
      ],
      "Default": "EnrichRows"
    },
    "DuplicateIgnored": {
      "Type": "Succeed",
      "Comment": "Nothing to do: another execution already processed (or is processing) this upload.",
      "OutputPath": "$.batch"
    },
    "EnrichRows": {
      "Type": "Map",
      "Comment": "One enrich invocation per row. MaxConcurrency caps provider calls per minute; the function itself retries 429/5xx.",
      "ItemsPath": "$.batch.rows",
      "MaxConcurrency": ${max_concurrency},
      "ItemSelector": {
        "batch_id.$": "$.batch.batch_id",
        "batch_date.$": "$.batch.batch_date",
        "row.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "EnrichRow",
        "States": {
          "EnrichRow": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${enrich_arn}",
              "Payload.$": "$"
            },
            "ResultSelector": {
              "row_number.$": "$.Payload.row_number",
              "status.$": "$.Payload.status",
              "method.$": "$.Payload.method",
              "credits_consumed.$": "$.Payload.credits_consumed",
              "attempts.$": "$.Payload.attempts"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2.0,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "RowFailed"
              }
            ],
            "End": true
          },
          "RowFailed": {
            "Type": "Pass",
            "Comment": "A crashed row becomes an error record instead of failing the batch; the curated step still runs.",
            "Parameters": {
              "row_number.$": "$.row.row_number",
              "status": "error",
              "error.$": "$.error.Error",
              "cause.$": "$.error.Cause"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.enriched",
      "Next": "BuildCurated"
    },
    "BuildCurated": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "row_errors carries the rows whose invocation crashed (RowFailed records) so the curated step records them as error rows.",
      "Parameters": {
        "FunctionName": "${build_curated_arn}",
        "Payload": {
          "batch_id.$": "$.batch.batch_id",
          "batch_date.$": "$.batch.batch_date",
          "row_errors.$": "$.enriched[?(@.status == 'error')]"
        }
      },
      "ResultSelector": {
        "persons.$": "$.Payload.persons",
        "employment_rows.$": "$.Payload.employment_rows",
        "credits_spent.$": "$.Payload.credits_spent",
        "status_counts.$": "$.Payload.status_counts",
        "quality_warnings.$": "$.Payload.quality.warning_count",
        "quality_notes.$": "$.Payload.quality.notes",
        "rejected_rows_ref.$": "$.Payload.rejected_rows_ref",
        "manifest_ref.$": "$.Payload.manifest_ref"
      },
      "ResultPath": "$.curated",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "Summarize"
    },
    "Summarize": {
      "Type": "Pass",
      "Parameters": {
        "batch_id.$": "$.batch.batch_id",
        "batch_date.$": "$.batch.batch_date",
        "source.$": "States.Format('s3://{}/{}', $.bucket, $.key)",
        "row_count.$": "$.batch.row_count",
        "invalid_count.$": "$.batch.invalid_count",
        "row_errors.$": "States.ArrayLength($.enriched[?(@.status == 'error')])",
        "failed_rows.$": "States.JsonToString($.enriched[?(@.status == 'error')].row_number)",
        "curated.$": "$.curated"
      },
      "ResultPath": "$.summary",
      "Next": "AnyRowErrors"
    },
    "AnyRowErrors": {
      "Type": "Choice",
      "Comment": "Notify when a row crashed or the curated step raised data-quality warnings (low match rate, many rejected rows, flagged matches, decoding fallbacks).",
      "Choices": [
        {
          "Or": [
            {
              "Variable": "$.summary.row_errors",
              "NumericGreaterThan": 0
            },
            {
              "Variable": "$.summary.curated.quality_warnings",
              "NumericGreaterThan": 0
            }
          ],
          "Next": "NotifyPartialFailure"
        }
      ],
      "Default": "Succeeded"
    },
    "NotifyPartialFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${alerts_topic_arn}",
        "Subject": "People-enrichment: batch completed with warnings",
        "Message.$": "States.Format('Batch {} from {} completed with {} row error(s) out of {} rows (input row numbers {}) and {} data-quality warning(s): {}. Persons curated: {}. Rejected rows file: {}. Manifest: {}. Execution: {}', $.summary.batch_id, $.summary.source, $.summary.row_errors, $.summary.row_count, $.summary.failed_rows, $.summary.curated.quality_warnings, $.summary.curated.quality_notes, $.summary.curated.persons, $.summary.curated.rejected_rows_ref, $.summary.curated.manifest_ref, $$.Execution.Id)"
      },
      "ResultPath": null,
      "Next": "Succeeded"
    },
    "Succeeded": {
      "Type": "Succeed",
      "OutputPath": "$.summary"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${alerts_topic_arn}",
        "Subject": "People-enrichment: pipeline execution FAILED",
        "Message.$": "States.Format('Execution {} failed for s3://{}/{}. Error: {}. Cause: {}', $$.Execution.Id, $.bucket, $.key, $.error.Error, $.error.Cause)"
      },
      "ResultPath": null,
      "Next": "Failed"
    },
    "Failed": {
      "Type": "Fail",
      "ErrorPath": "$.error.Error",
      "CausePath": "$.error.Cause"
    }
  }
}
